# Dataset (too large / not ours to redistribute — download separately via Kaggle)
dataset/*
!dataset/.gitkeep

# Trained model weights (large binary files, regenerate by training)
*.pth
*.pt

# Grad-CAM output images generated at the project root by `main.py`
# (not the ones intentionally committed under assets/ for the README —
# the leading "/" anchors these to the root only, since an unanchored
# pattern like "gradcam_grid.png" would also match assets/gradcam_grid.png)
/gradcam_output.png
/gradcam_grid.png
/gradcam_failures.png

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# OS/editor cruft
.DS_Store
.vscode/
.idea/
